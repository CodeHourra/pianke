{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "片刻",
  "version": "0.1.0",
  "identifier": "com.pianke.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../app.py": "pianke/app.py",
      "../../pyproject.toml": "pianke/pyproject.toml",
      "../../pic_selecter/": "pianke/pic_selecter/",
      "../../static/": "pianke/static/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
